NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=3000

# Supabase project settings (Project Settings -> API). The anon key is safe to
# expose to the browser — RLS on the `profiles` table (see
# supabase/migrations/0001_profiles_and_auth.sql) is what actually protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Settings -> API -> JWT Settings -> "JWT Secret". Server-only (no NEXT_PUBLIC_
# prefix) — used to verify session JWTs locally in Server Components
# (lib/auth/session-claims.ts). Must never reach the browser.
SUPABASE_JWT_SECRET=your-jwt-secret
