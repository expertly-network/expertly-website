{
  "name": "growxq-backend",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build && node scripts/postbuild.mjs",
    "start": "node dist/apps/backend/src/main.js",
    "dev": "node scripts/dev.mjs",
    "worker": "nest build && node scripts/postbuild.mjs && node dist/apps/backend/src/worker.js",
    "start:worker": "node dist/apps/backend/src/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,scripts}/**/*.ts\"",
    "gen:types": "npx --yes supabase gen types typescript --db-url \"$SUPABASE_DB_URL\" > src/supabase/database.types.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.92",
    "@ai-sdk/google": "^4.0.108",
    "@ai-sdk/openai": "^4.0.105",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.8",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-fastify": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.157",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "country-state-city": "3.2.1",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^17.4.2",
    "file-type": "^21.3.4",
    "jose": "^6.2.14",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@growxq/shared-types": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@types/node": "^20.19.43",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9.39.5",
    "fastify": "^5.12.7",
    "tsc-alias": "^1.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
