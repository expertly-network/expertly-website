{
  "name": "expertly-backend",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build && node scripts/postbuild.mjs",
    "start": "node dist/apps/backend/src/main.js",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,scripts}/**/*.ts\"",
    "gen:types": "npx --yes supabase gen types typescript --db-url \"$SUPABASE_DB_URL\" > src/supabase/database.types.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.46",
    "@ai-sdk/google": "^4.0.58",
    "@ai-sdk/openai": "^4.0.52",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@supabase/supabase-js": "^2.112.2",
    "ai": "^7.0.85",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "file-type": "16",
    "jose": "^6.2.8",
    "mammoth": "^1.12.2",
    "pdf-parse": "^1.1.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@expertly/shared-types": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@types/node": "^20.17.10",
    "@types/pdf-parse": "^1.1.5",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.17.0",
    "fastify": "^5.11.3",
    "tsc-alias": "^1.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
