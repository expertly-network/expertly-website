PORT=4000

# Supabase project settings (Project Settings -> API). SUPABASE_URL alone is
# enough to verify session tokens (src/auth/verify-token.ts fetches the
# project's public keys from its JWKS endpoint) — no separate JWT secret
# needed.
SUPABASE_URL=https://your-project.supabase.co

# Service role key — bypasses RLS. Used only for RolesGuard's fresh
# profiles.role re-check on 🛡️ Admin routes (src/auth/guards/roles.guard.ts),
# not on every request. Keep this out of any frontend-facing env file; it must
# never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LinkedIn import — n8n-backed profile scrape (apps/backend/src/applications/linkedin-import/).
# Omit to fall back to the deterministic MockLinkedInImportProvider, which is fine for local dev
# without real credentials. Points at an n8n Chat Trigger webhook — POST { chatInput, sessionId }.
LINKEDIN_IMPORT_WEBHOOK_URL=https://your-n8n-host/webhook/your-workflow-id/chat

# AI-assisted article drafting (src/ai/) — POST /v1/articles/ai-draft. Provider and model are
# fixed server-side via these two env vars, never client-selectable. Uses the Vercel `ai` SDK
# (@ai-sdk/openai / @ai-sdk/anthropic / @ai-sdk/google) so adding a provider is a new `case` in
# src/ai/ai.service.ts, not a new hand-rolled client. Set AI_PROVIDER to one of
# openai | anthropic | google, AI_MODEL to that provider's model id, and ONLY the matching API
# key below — leave all three unset to disable AI drafting (the endpoint 503s; manual article
# writing is unaffected).
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Article editorial review (src/articles/articles.service.ts). 'instant' (default, or unset):
# submitting an article publishes it immediately, same as before this toggle existed. 'editorial':
# submitting sets status to pending_review instead — an admin with the manageArticles permission
# then approves (publishes) or rejects it via GET/PATCH /v1/admin/articles.
ARTICLES_REVIEW_MODE=instant

# Write flow "auto-selected cover image" — POST/GET /v1/articles/cover-images proxies a live
# Unsplash search (src/ai/unsplash.service.ts) so this key never reaches the client. Leave unset
# to disable (the endpoint 503s; the rest of the write flow is unaffected).
UNSPLASH_ACCESS_KEY=
