# Every variable below is validated at boot (src/config/env.ts): a missing required one or a
# malformed value (bad URL, unknown enum value) stops the process with the variable NAMES logged.
# Empty values (`KEY=`) count as unset. The search worker (src/worker.ts) additionally requires
# OPENAI_API_KEY.
#
# development | production | test (default development). The Docker image sets production.
# NODE_ENV=

PORT=4000

# Supabase project settings (Project Settings -> API). SUPABASE_URL alone is
# enough to verify session tokens (src/auth/verify-token.ts fetches the
# project's public keys from its JWKS endpoint) — no separate JWT secret
# needed.
SUPABASE_URL=https://your-project.supabase.co

# Service role key — bypasses RLS. Used only for RolesGuard's fresh
# profiles.role re-check on 🛡️ Admin routes (src/auth/guards/roles.guard.ts),
# not on every request. Keep this out of any frontend-facing env file; it must
# never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only needed to run `pnpm gen:types` (regenerates src/supabase/database.types.ts after a schema
# change) — the app itself never reads this. The direct Postgres connection string from Project
# Settings -> Database -> Connection string (URI, with password). Never commit the real value.
SUPABASE_DB_URL=

# LinkedIn import — n8n-backed profile scrape (apps/backend/src/applications/linkedin-import/).
# Omit to fall back to the deterministic MockLinkedInImportProvider, which is fine for local dev
# without real credentials. Points at an n8n Chat Trigger webhook — POST { chatInput, sessionId }.
LINKEDIN_IMPORT_WEBHOOK_URL=https://your-n8n-host/webhook/your-workflow-id/chat

# AI-assisted article drafting (src/ai/) — POST /v1/articles/ai-draft. Provider and model are
# fixed server-side via these two env vars, never client-selectable. Uses the Vercel `ai` SDK
# (@ai-sdk/openai / @ai-sdk/anthropic / @ai-sdk/google) so adding a provider is a new `case` in
# src/ai/ai.service.ts, not a new hand-rolled client. Set AI_PROVIDER to one of
# openai | anthropic | google, AI_MODEL to that provider's model id, and ONLY the matching API
# key below — leave all three unset to disable AI drafting (the endpoint 503s; manual article
# writing is unaffected).
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# AI search (src/search/, src/search-worker/). Uses OPENAI_API_KEY above, independent of
# AI_PROVIDER/AI_MODEL. Embeddings are fixed at 768 dimensions to match search_documents.
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Article editorial review (src/articles/articles.service.ts). 'instant' (default, or unset):
# submitting an article publishes it immediately, same as before this toggle existed. 'editorial':
# submitting sets status to pending_review instead — an admin with the manageArticles permission
# then approves (publishes) or rejects it via GET/PATCH /v1/admin/articles.
ARTICLES_REVIEW_MODE=instant

# Write flow "auto-selected cover image" — POST/GET /v1/articles/cover-images proxies a live
# Unsplash search (src/ai/unsplash.service.ts) so this key never reaches the client. Leave unset
# to disable (the endpoint 503s; the rest of the write flow is unaffected).
UNSPLASH_ACCESS_KEY=

# Consultation request rate limit (src/consultations/consultations.service.ts). Optional — max
# requests a single requester may send within the window. Defaults to 3 if unset.
CONSULTATION_REQUEST_LIMIT=
# Optional — window size in days for the above limit. Defaults to 1 if unset.
CONSULTATION_REQUEST_WINDOW_DAYS=
# Optional — how many days a still-pending request to the SAME member blocks a new one to that
# member (separate from the global rate limit above). Defaults to 15 if unset.
CONSULTATION_PENDING_COOLDOWN_DAYS=

# Comma-separated browser origins allowed by CORS (the frontend domains), each an http(s) origin.
# REQUIRED when NODE_ENV=production (the API refuses to boot without it). Unset in development =
# any origin, with a warning.
CORS_ORIGINS=http://localhost:3000

# Interactive API docs at /api. On by default outside production; set to true to keep them in
# production (they list every route, admin ones included).
SWAGGER_ENABLED=

# Request logging needs no config: one line per request (method, path without query string,
# status, duration, request id), no headers or bodies, health probes skipped. A caller-supplied
# X-Request-Id (letters, digits, . _ -, up to 64 chars) is reused and echoed back; otherwise one is
# generated. GET /v1/health is liveness; GET /v1/health/ready also checks the database.

# Founding-cohort pre-launch — set together with the frontend's SITE_LAUNCHED. "false" = pre-launch:
# the membership application does not collect (or require) peer references. Unset = launched.
SITE_LAUNCHED=false
