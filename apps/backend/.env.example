PORT=4000

# Supabase project settings (Project Settings -> API). SUPABASE_URL alone is
# enough to verify session tokens (src/auth/verify-token.ts fetches the
# project's public keys from its JWKS endpoint) — no separate JWT secret
# needed.
SUPABASE_URL=https://your-project.supabase.co

# Service role key — bypasses RLS. Used only for RolesGuard's fresh
# profiles.role re-check on 🛡️ Admin routes (src/auth/guards/roles.guard.ts),
# not on every request. Keep this out of any frontend-facing env file; it must
# never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LinkedIn import — n8n-backed profile scrape (apps/backend/src/applications/linkedin-import/).
# REQUIRED, including local dev — there is no mock fallback. The app throws at boot if this is
# unset. Points at an n8n Chat Trigger webhook — POST { chatInput, sessionId }.
LINKEDIN_IMPORT_WEBHOOK_URL=https://your-n8n-host/webhook/your-workflow-id/chat
