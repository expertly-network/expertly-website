NEXT_PUBLIC_API_URL=http://localhost:4000
# The backend's public URL, read at RUNTIME (per container) by the server and handed to the
# browser — see lib/api/base-url.shared.ts. Set it per deployment (Coolify env var); no rebuild
# needed to change it. Falls back to NEXT_PUBLIC_API_URL above when unset (fine for local dev).
API_URL=http://localhost:4000
PORT=3000

# This app's own public origin (no trailing slash). REQUIRED in production: the OAuth/email
# callback (app/auth/callback/route.ts) redirects only to this origin — never to the request's
# Host / X-Forwarded-Host — and metadataBase (app/layout.tsx) uses it for Open Graph URLs. Read at
# runtime (set it as a Coolify runtime env var); defaults to http://localhost:3000 in dev only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings (Project Settings -> API). The anon key is safe to
# expose to the browser — RLS on the `profiles` table (see
# supabase/migrations/0001_profiles_and_auth.sql) is what actually protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
