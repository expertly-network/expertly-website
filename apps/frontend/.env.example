NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=3000

# This app's own public origin (no trailing slash) — used only for metadataBase (see
# app/layout.tsx), so Open Graph tags (LinkedIn/Reddit/Quora share previews) resolve to real
# absolute URLs. Defaults to http://localhost:3000 if unset; set to the real deployed domain in
# production, or link previews will point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings (Project Settings -> API). The anon key is safe to
# expose to the browser — RLS on the `profiles` table (see
# supabase/migrations/0001_profiles_and_auth.sql) is what actually protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
