# Deployment config — read at RUNTIME only (lib/env.ts), never baked into the build. Set these per
# deployment as Coolify env vars on the frontend app (runtime; no rebuild needed to change them).
# The server hands them to the browser via an inline script in the root layout.

# The backend's public URL. Required in production (no fallback); defaults to localhost:4000 in dev.
API_URL=http://localhost:4000
PORT=3000

# This app's public origin (no trailing slash) — or, when one container serves several domains, a
# comma-separated list, canonical first (e.g. https://expertly.network,https://dev.expertly.network).
# REQUIRED in production: the OAuth/email callback (app/auth/callback/route.ts) redirects only to
# one of these origins (the one matching the request's host, else the first) — a client-supplied
# Host / X-Forwarded-Host can never send it elsewhere — and metadataBase (app/layout.tsx) uses the
# first for Open Graph URLs. Read at runtime (Coolify runtime env var); defaults to
# http://localhost:3000 in dev only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings (Project Settings -> API). Required, also at runtime. The anon key is
# safe to expose to the browser — RLS on the `profiles` table (see
# supabase/migrations/0001_profiles_and_auth.sql) is what actually protects data.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Launch switch, read at RUNTIME (Coolify env var — flip it and restart, no rebuild). `false` = pre-launch:
# only the teaser at `/`, sign-in/sign-up, /apply and /legal stay open (plus /admin, which is
# admin-only anyway); every other page redirects. Signed-in admins bypass the gate and see the whole
# site (the teaser stays at /welcome for them). Unset or anything else = launched (full site).
# Set the backend's SITE_LAUNCHED to the same value (it waives peer references pre-launch).
# SITE_LAUNCHED=false
