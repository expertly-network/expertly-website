{
  "name": "growxq-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run dev:kill && turbo run dev",
    "dev:kill": "bash scripts/kill-dev.sh",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"apps/backend/{src,scripts}/**/*.{ts,mjs}\" \"apps/frontend/{app,components,lib}/**/*.{ts,tsx}\" \"apps/frontend/*.{ts,js}\" \"packages/shared-types/*.ts\"",
    "format:check": "prettier --check \"apps/backend/{src,scripts}/**/*.{ts,mjs}\" \"apps/frontend/{app,components,lib}/**/*.{ts,tsx}\" \"apps/frontend/*.{ts,js}\" \"packages/shared-types/*.ts\""
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "^2.10.9"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "fastify": "^5.12.7",
      "multer": "^2.5.0",
      "js-yaml@4": "^4.3.2",
      "js-yaml@5": "^5.4.1",
      "postcss@8": "^8.5.18",
      "source-map-js": "^1.2.2"
    }
  }
}
