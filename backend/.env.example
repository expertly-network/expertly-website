PORT=4000

# Supabase project settings (Project Settings -> API).
SUPABASE_URL=https://your-project.supabase.co       

# Settings -> API -> JWT Settings -> "JWT Secret". Verifies session tokens
# locally (see src/auth/verify-token.ts) — no per-request call to Supabase.     
SUPABASE_JWT_SECRET=your-jwt-secret

# Service role key — bypasses RLS. Used only for RolesGuard's fresh
# profiles.role re-check on 🛡️ Admin routes (src/auth/guards/roles.guard.ts),
# not on every request. Keep this out of any frontend-facing env file; it must
# never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
