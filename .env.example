# Used only by docker-compose.yml to bake these NEXT_PUBLIC_* vars into the
# frontend build (Next.js inlines them into the client bundle at build time).
# Point NEXT_PUBLIC_API_URL at wherever the backend is reachable (public URL
# in prod); the Supabase values come from Project Settings -> API.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
