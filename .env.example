# Used only by `docker compose up --build` (root docker-compose.yml) to pass
# NEXT_PUBLIC_* build args to the frontend image. Per-service runtime env vars
# still live in apps/backend/.env and apps/frontend/.env — see their own
# .env.example files.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
